# =============================================================================
# Every value here is read at RUNTIME. Nothing is inlined at build time, so a
# single container image is promoted unchanged across dev1 / staging1 / prod.
# Do not reintroduce NEXT_PUBLIC_* variables: Next.js bakes those into the
# client bundle during `next build`, which would pin an image to one environment.
# =============================================================================

# ===== Auth =====
BETTER_AUTH_SECRET=32_BYTE_SECRET_KEY
BETTER_AUTH_URL=http://localhost:3000

# Public origin of this deployment (no trailing slash, no /api suffix).
# Used to build absolute links in outgoing emails.
APP_URL=http://localhost:3000

# ===== Database =====
# DIRECT_URL is a Prisma setting (used for migrations); when the database is not
# behind a connection pooler, point it at the same server as DATABASE_URL.
DATABASE_URL=postgresql://badir:badir@localhost:5432/badir
DIRECT_URL=postgresql://badir:badir@localhost:5432/badir

# ===== Object storage (S3-compatible: MinIO locally, Cloudflare R2 deployed) =====
# The logical buckets (avatars, documents, post-images) are key prefixes inside
# this single bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=badir
# Base URL objects are publicly served from.
S3_PUBLIC_URL=http://localhost:9000/badir
# MinIO needs path-style addressing; set to false for Cloudflare R2 and AWS S3.
S3_FORCE_PATH_STYLE=true

# ===== Resend (transactional email only) =====
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@domain
CONTACT_EMAIL=contact@domain

# ===== MailerLite (newsletter / marketing email only) =====
# https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=your_mailerlite_api_key_here
MAILERLITE_WEBHOOK_SECRET=your_webhook_signing_secret_here # Generate with: openssl rand -hex 32
MAILERLITE_SUBSCRIBERS_GROUP_ID=your_mailerlite_subscribers_group_id_here

# ===== Scheduled jobs =====
# Shared secret the scheduler sends as `Authorization: Bearer <secret>` when
# calling /api/cron/*. Generate with: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# ===== Upstash Redis (rate limiting) =====
# https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
